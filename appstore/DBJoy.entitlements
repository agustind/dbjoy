<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build. scripts/make-appstore.sh adds the application and team identifiers. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Connections to database and SSH servers. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- SSH tunnels: ssh -L listens on a 127.0.0.1 port that DBJoy then connects to. -->
    <key>com.apple.security.network.server</key><true/>
    <!-- Exports, backups and .sql files the user picks in open/save panels or drags in. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Remembers access to the SSH private key picked for a connection. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
</dict>
</plist>
